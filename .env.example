# The only .env.example in the repository — per-package env files are not allowed.
#
# No secrets live here, ever: this is play money, a demo token, and no operator credentials. If the
# real RGS later needs any, they arrive as environment variables with placeholder names
# (<RGS_TOKEN>, <DB_PASSWORD>) and never as a committed default.
#
# The consumer block is named on each line; anything without one is read today.

# Which RGS the client talks to: "mock" (in-process simulator) or "http".   [C3]
VITE_RGS_TRANSPORT=mock

# Base URL used when VITE_RGS_TRANSPORT=http — apps/mock-rgs today, the real RGS later.   [C3]
VITE_RGS_BASE_URL=http://localhost:8787

# ── apps/mock-rgs ─────────────────────────────────────────────────────────────
# All optional: every value below is the default, and `pnpm dev:rgs` needs none of them.

MOCK_RGS_PORT=8787
MOCK_RGS_HOST=127.0.0.1

# Fixes the whole session's outcome sequence — the same seed replays it identically.
MOCK_RGS_SEED=mock-rgs-dev-seed

# Starting balance, in integer minor units.
MOCK_RGS_BALANCE=1000000

# Whether the server honours `forceOutcome` (docs/protocol.md §8). True here because this server
# exists to be driven; the production gate is that a real RGS sets it false.
MOCK_RGS_DEV_MODE=true

MOCK_RGS_SESSION_HOURS=12
MOCK_RGS_LOG_LEVEL=info

# ── apps/rgs ──────────────────────────────────────────────────────────────────
# All optional: every value below is the default. `pnpm --filter @slot/rgs dev` needs none of them.

RGS_PORT=8788
RGS_HOST=127.0.0.1
RGS_LOG_LEVEL=info

# The demo session issued at boot (§7 — the environment is the out-of-band lobby in development).
# R5 replaces this with operator-issued sessions.
RGS_DEMO_TOKEN=rgs-demo-token
RGS_SESSION_HOURS=12

# Demo wallet balance, in integer minor units (MockWallet until R2).
RGS_BALANCE=1000000

# How often the ledger is trued against the wallet, in ms (R3). 0 disables the job.
RGS_RECONCILE_INTERVAL_MS=60000

# Set to select the Postgres store and ledger; absent means in-memory. Placeholder shape only —
# real credentials never live in this file.
# RGS_DATABASE_URL=postgres://<DB_USER>:<DB_PASSWORD>@127.0.0.1:5432/slot_rgs

# Base URL of an operator wallet speaking docs/wallet-api.md — selects RemoteWallet (timeouts,
# bounded retries, idempotent refs). Absent means the in-process MockWallet.
# RGS_WALLET_URL=http://127.0.0.1:8789

# Points the store- and ledger-contract tests at a database (always set in CI via a container).
# RGS_TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/postgres
