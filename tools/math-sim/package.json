{
  "name": "@slot/math-sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "math-sim": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../config/vitest.package.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@slot/game-math": "workspace:*",
    "@slot/money": "workspace:*",
    "@slot/protocol": "workspace:*",
    "@slot/rgs-sim": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
