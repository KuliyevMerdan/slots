# The only .env.example in the repository — per-package env files are not allowed.
#
# No secrets live here, ever: this is play money, a demo token, and no operator credentials. If the
# real RGS later needs any, they arrive as environment variables with placeholder names
# (<RGS_TOKEN>, <DB_PASSWORD>) and never as a committed default.
#
# Nothing reads these yet — the consumer block is named on each line.

# Which RGS the client talks to: "mock" (in-process simulator) or "http".   [C3]
VITE_RGS_TRANSPORT=mock

# Base URL used when VITE_RGS_TRANSPORT=http — apps/mock-rgs today, the real RGS later.   [S2]
VITE_RGS_BASE_URL=http://localhost:8787

# Port apps/mock-rgs listens on.   [S2]
MOCK_RGS_PORT=8787
